{
  "name": "pabrik-sus",
  "version": "0.1.0",
  "description": "Rakit exe & installer dari ZIP kode sumber, tanpa login",
  "main": "main.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "postinstall": "node scripts/setup.js",
    "start": "electron .",
    "build:win": "node scripts/setup.js && electron-builder --win --x64"
  },
  "keywords": [],
  "author": "@SuS_X_x",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "Pabrik SuS",
  "build": {
    "appId": "id.sus.pabrik",
    "productName": "Pabrik SuS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "app/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PabrikSuS-Setup-${version}.${ext}",
      "shortcutName": "Pabrik SuS"
    },
    "artifactName": "PabrikSuS-${version}-${os}-${arch}.${ext}"
  }
}